<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Quyền sinh trắc học chuẩn cho Android -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Hỗ trợ thiết bị Android cũ hơn API 28 -->
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <!-- Quyền camera trước phục vụ quét khuôn mặt on-device -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <application
        android:name=".BiometricApp"
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.BiometricDemo">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.BiometricDemo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".biometric.face.FaceScanActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.BiometricDemo" />
    </application>

</manifest>
